# Intentional static assets, fixtures, evidence summaries and dependency locks.
# These exceptions do not admit operational state trees or .gaia/.
!/tests/**
!/docs/**
!/examples/**
!/archives/text_prototype/**
!/keys/**
!/requirements/**

# This reserved directory contains a static explanation, not a campaign state.
!/state_gaia_transformer_cuda/
/state_gaia_transformer_cuda/*
!/state_gaia_transformer_cuda/README.md

# Caches remain ignored even inside the static trees above.
__pycache__/
