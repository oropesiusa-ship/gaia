[Unit]
Description=Evaluate and power off the disposable VM
Requires=gaia-guardian.service gaia-offline.service
After=gaia-guardian.service gaia-offline.service
RequiresMountsFor=/core /data

[Service]
Type=oneshot
WorkingDirectory=/core
ExecStart=/opt/gaia/venv/bin/python -I /core/probe.py
ExecStopPost=/usr/bin/systemctl --no-block poweroff
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=150

[Install]
WantedBy=multi-user.target
